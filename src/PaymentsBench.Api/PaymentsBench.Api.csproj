<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <UserSecretsId>payments-bench-api</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PaymentsBench.Infrastructure\PaymentsBench.Infrastructure.csproj" />
    <ProjectReference Include="..\PaymentsBench.Iso20022\PaymentsBench.Iso20022.csproj" />
    <ProjectReference Include="..\PaymentsBench.ServiceDefaults\PaymentsBench.ServiceDefaults.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>
  <ItemGroup>
    <!-- Scheme and calendar data (rule 7): copied next to the binaries; Schemes__Directory overrides. -->
    <None Include="..\..\scenarios\schemes.yaml" Link="scenarios\schemes.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\scenarios\calendars\*.yaml" Link="scenarios\calendars\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
