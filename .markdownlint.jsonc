{
  // Markdown rule configuration for this repository.
  "default": true,

  // MD013 line length: off. Prose and tables; hard wrapping re-flows whole paragraphs for a one-word edit.
  "MD013": false,

  // MD024 duplicate headings: only siblings. ADRs legitimately repeat Context / Decision / Consequences.
  "MD024": {
    "siblings_only": true
  },

  // MD029 ordered lists: always "1." so inserting a step is a one-line diff.
  "MD029": {
    "style": "one"
  },

  // MD033 inline HTML: a narrow allow-list for constructs with no Markdown equivalent on GitHub.
  "MD033": {
    "allowed_elements": ["a", "br", "details", "summary", "img", "kbd", "sub", "sup"]
  },

  // MD036 emphasis used as heading: off. Bold lead-ins are an idiom in these documents.
  "MD036": false,

  // MD040 fenced code language: required, so a block says whether it is shell, config or output.
  "MD040": true,

  // MD046 code block style: fenced only; indented blocks lose their language tag.
  "MD046": {
    "style": "fenced"
  },

  // MD060 table pipe spacing: off. GitHub renders padded and compact tables identically.
  "MD060": false
}
